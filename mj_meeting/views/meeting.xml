<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_meeting_tree" model="ir.ui.view">
        <field name="name">hr.meeting.list</field>
        <field name="model">hr.meeting</field>
        <field name="arch" type="xml">
            <list string="Meetings">
                <field name="name"/>
                <field name="title"/>
                <field name="meeting_date"/>
                <field name="employee_id" widget="many2many_avatar_employee"/>
                <field name="task_count" string="Tasks"/>
            </list>
        </field>
    </record>

    <record id="view_hr_meeting_form" model="ir.ui.view">
        <field name="name">hr.meeting.form</field>
        <field name="model">hr.meeting</field>
        <field name="arch" type="xml">
            <form string="Meeting">
                <header>
                    <button name="action_send_meeting_email"
                            type="object"
                            string="Send Email"
                            class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object"
                                class="oe_stat_button"
                                icon="fa-tasks"
                                name="action_view_tasks">
                            <field name="task_count" widget="statinfo" string="Tasks"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="title"/>
                        <field name="meeting_date"/>
                        <field name="agenda"/>
                        <field name="employee_id" widget="many2many_avatar_employee" options="{'no_create': True}"/>
                        <field name="meeting_minutes"/>
                    </group>
                    <notebook>
                        <page string="Tasks" name="tasks">
                            <field name="task_ids"
                                   context="{'default_meeting_id': id, 'list_view_ref': 'mj_meeting.view_meeting_task_list', 'form_view_ref': 'mj_meeting.view_meeting_task_form'}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_meeting_search" model="ir.ui.view">
        <field name="name">hr.meeting.search</field>
        <field name="model">hr.meeting</field>
        <field name="arch" type="xml">
            <search string="Search Meetings">
                <field name="name" string="Meeting ID"/>
                <field name="title"/>
                <field name="employee_id"/>
                <filter name="filter_expected_date" string="Date Range" date="meeting_date"/>
                <group>
                    <filter name="group_by_meeting_date" string="Date" context="{'group_by': 'meeting_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_meeting" model="ir.actions.act_window">
        <field name="name">Meetings</field>
        <field name="res_model">hr.meeting</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_hr_meeting_tree"/>
        <field name="search_view_id" ref="view_hr_meeting_search"/>
    </record>

    <menuitem id="menu_meeting_root" name="Meeting" web_icon="mj_meeting,static/description/icon.png" sequence="10"/>
    <menuitem id="menu_meeting" name="Meetings"
            parent="menu_meeting_root"
            action="action_meeting"
            sequence="10"/>
    <menuitem id="menu_task_plan_meeting" name="Tasks"
            parent="menu_meeting_root"
            action="action_meeting_task"
            sequence="20"/>
</odoo>
