<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_hr_meeting" model="mail.template">
            <field name="name">Meeting: Notification</field>
            <field name="model_id" ref="mj_meeting.model_hr_meeting"/>
            <field name="subject">Meeting Notification: {{ object.title }}</field>
            <field name="email_from">notification@majestobd.com</field>
            <field name="description">Sent manually from a meeting to notify its attendees.</field>
            <field name="body_html" type="html">
                <div>
                    <p><strong>Meeting Title:</strong> <t t-out="object.title or ''">Weekly Sync</t></p>
                    <p><strong>Date:</strong> <t t-out="format_date(object.meeting_date) or ''">01/01/2026</t></p>
                    <p><strong>Agenda:</strong></p>
                    <t t-out="object.agenda or ''"/>
                    <p><strong>Meeting Minutes:</strong></p>
                    <t t-out="object.meeting_minutes or ''"/>
                </div>
            </field>
        </record>
    </data>
</odoo>
