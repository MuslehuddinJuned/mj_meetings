<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- A stored compute cannot notice that "today" moved on, so the
             Delayed smart status is refreshed once a day. -->
        <record id="ir_cron_recompute_smart_status" model="ir.cron">
            <field name="name">Meeting: Refresh Task Smart Status</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="state">code</field>
            <field name="code">model._cron_recompute_smart_status()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
